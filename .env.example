# Trade Abhyas local backend environment example.
# Copy to .env and fill real local/development values. Do not commit .env.

NODE_ENV=development
PORT=5500

# MongoDB database for the main local application.
# Automated order tests must use the separate `test` database.
MONGO_URI=<mongodb uri pointing to vstp>

JWT_SECRET=<strong local development secret>
FINNHUB_API_KEY=<optional market/news provider key>
NEWS_API_KEY=<optional news provider key>

CLIENT_URL=http://localhost:3010
ADMIN_URL=http://localhost:3016

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Comma-separated YYYY-MM-DD values.
NSE_HOLIDAYS=
