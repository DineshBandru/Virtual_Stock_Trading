NODE_ENV=production
PORT=5500

# Secret-managed production values. MONGO_URI must point to the vstp database.
MONGO_URI=<production Atlas URI pointing to vstp>
JWT_SECRET=<strong secret>
FINNHUB_API_KEY=<secret>
NEWS_API_KEY=<optional secret>
EMAIL_API_KEY=<secret>
EMAIL_FROM="Trade Abhyas <no-reply@example.com>"

# Exact allowed frontend origins. Use comma-separated origins only when needed.
CLIENT_URL=https://website.example.invalid
ADMIN_URL=https://admin.example.invalid

# Use COOKIE_SAME_SITE=none for cross-site frontend/backend deployments.
COOKIE_SECURE=true
COOKIE_SAME_SITE=none

# Example format only. Replace with official NSE holiday dates before production.
NSE_HOLIDAYS=2026-01-26,2026-03-03
